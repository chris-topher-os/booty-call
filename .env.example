# First-install values for `mise run deploy` (agent only). Copy to .env,
# deploy once, then ignore this file: the installed config
# (/etc/booty-call/agent.json or C:\ProgramData\booty-call\agent.json)
# becomes the source of truth and re-deploys need no .env at all.

BOOTY_BOX_ID=gpu
BOOTY_OS_ID=debian
BOOTY_ALLOWED_PEERS=fabrico
BOOTY_BOOT_ENTRIES='{"debian":1,"windows":2}'

# optional:
#BOOTY_CONTROL=fabrico.tawny-wyrm.ts.net
#BOOTY_WOL_IFACE=enp3s0
#BOOTY_PORT=8766
